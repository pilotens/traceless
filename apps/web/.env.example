# Public browser configuration. Do not put client secrets or service API keys here.
VITE_API_BASE_URL=http://localhost:8000

# Configure all OIDC values together. Authorization Code + PKCE is used; the client
# must be registered as a public SPA client with this exact redirect URI.
# VITE_OIDC_AUTHORIZATION_URL=https://login.example.com/tenant/oauth2/v2.0/authorize
# VITE_OIDC_TOKEN_URL=https://login.example.com/tenant/oauth2/v2.0/token
# VITE_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/
# VITE_OIDC_SCOPES=openid profile email api://traceless/access
