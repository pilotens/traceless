{
  "name": "@traceless/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "swagger-typescript-api generate -p openapi.json -o src/generated/traceless-api -n contracts.ts --no-client --enum-style union --sort-types --clean-output --silent"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "29.1.1",
    "swagger-typescript-api": "13.12.6",
    "typescript": "7.0.2",
    "vite": "^6.1.0",
    "vitest": "4.1.10"
  }
}
