# All values are local-development defaults. Lists must be JSON arrays.
TRACELESS_ENVIRONMENT=development
TRACELESS_DEBUG=false
TRACELESS_API_V1_PREFIX=/api/v1
TRACELESS_ENABLE_DOCS=true
TRACELESS_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
TRACELESS_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
TRACELESS_DATABASE_URL=sqlite+pysqlite:///./traceless.db
TRACELESS_AUTO_CREATE_SCHEMA=true
TRACELESS_MAX_REQUEST_BODY_BYTES=33554432

# Optional machine identity. Production requires this or OIDC. The organization and
# roles are fixed here, never accepted from the caller. Keep the key in a secret manager.
# TRACELESS_OPERATIONAL_API_KEY=replace-with-at-least-32-random-characters
# TRACELESS_OPERATIONAL_ACTOR_NAME=authenticated-api-client
# TRACELESS_OPERATIONAL_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
# TRACELESS_OPERATIONAL_ORGANIZATION_KEY=default
# TRACELESS_OPERATIONAL_ORGANIZATION_NAME=Default Organization
# TRACELESS_OPERATIONAL_ROLES=["admin"]
# Machine identities with project/system assignments are restricted to those UUIDs.
# A non-admin identity with no assignments is fail-closed. Set scope-all explicitly
# only for a deliberately organization-wide service identity.
# TRACELESS_OPERATIONAL_PROJECT_IDS=[]
# TRACELESS_OPERATIONAL_SYSTEM_IDS=[]
# TRACELESS_OPERATIONAL_RESOURCE_SCOPE_ALL=false

# Browser/user identity. All three OIDC values and an exact HTTPS hostname allowlist
# are required together. Configure the claim names and map provider roles to the four
# operational roles: admin, analyst, viewer and scanner. Mapping is explicit:
# raw claims such as "admin" are rejected unless they appear as a map key.
# TRACELESS_OIDC_ISSUER=https://login.example.com/tenant/v2.0
# TRACELESS_OIDC_AUDIENCE=api://traceless
# TRACELESS_OIDC_JWKS_URL=https://login.example.com/tenant/discovery/v2.0/keys
# TRACELESS_OIDC_ALLOWED_HOSTS=["login.example.com"]
# TRACELESS_OIDC_ORGANIZATION_CLAIM=tid
# TRACELESS_OIDC_ORGANIZATION_NAME_CLAIM=tenant_name
# TRACELESS_OIDC_ROLES_CLAIM=roles
# Resource claims accept UUID arrays. A missing/empty claim is fail-closed; use the
# explicit value "*" for a deliberately organization-wide assignment.
# TRACELESS_OIDC_PROJECT_IDS_CLAIM=traceless_project_ids
# TRACELESS_OIDC_SYSTEM_IDS_CLAIM=traceless_system_ids
# TRACELESS_OIDC_ROLE_MAP={"Traceless.Admin":"admin","Traceless.Analyst":"analyst","Traceless.Viewer":"viewer","Traceless.Scanner":"scanner"}

# Active scanning must run in an isolated worker and is disabled by default.
# Nmap is not bundled; review NPSL/OEM terms before using it in a distributed product.
TRACELESS_NMAP_ENABLED=false
TRACELESS_NMAP_BINARY=nmap
TRACELESS_SCAN_MAX_HOSTS=256
TRACELESS_SCAN_TIMEOUT_SECONDS=900
TRACELESS_SCAN_WORKER_ID=scanner-worker
TRACELESS_SCAN_LEASE_GRACE_SECONDS=60
TRACELESS_SCAN_HEARTBEAT_SECONDS=15
TRACELESS_SCAN_MAX_ATTEMPTS=3
TRACELESS_ALLOW_PUBLIC_SCAN_TARGETS=false
TRACELESS_MAX_NMAP_XML_BYTES=10000000
TRACELESS_RETAIN_RAW_SCAN_EVIDENCE=false
TRACELESS_MAX_VULNERABILITY_SCAN_BYTES=33554432
TRACELESS_MAX_VULNERABILITY_OBSERVATIONS=50000

# Durable worker for large normalized imports and report rendering. Run the API
# and `traceless-job-worker` as separate processes against the same PostgreSQL DB.
TRACELESS_BACKGROUND_JOB_WORKER_ID=background-worker
TRACELESS_BACKGROUND_JOB_LEASE_SECONDS=300
TRACELESS_BACKGROUND_JOB_HEARTBEAT_SECONDS=15
TRACELESS_BACKGROUND_JOB_RETRY_DELAY_SECONDS=5
TRACELESS_BACKGROUND_JOB_MAX_ATTEMPTS=3

# Official enrichment endpoints; tokens and API keys belong in a secret manager.
TRACELESS_CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
TRACELESS_EPSS_API_URL=https://api.first.org/data/v1/epss
TRACELESS_NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
TRACELESS_INTELLIGENCE_ALLOWED_HOSTS=["www.cisa.gov","api.first.org","services.nvd.nist.gov"]
# TRACELESS_NVD_API_KEY=

# Pull normalized datapoints from a separately operated scraper/analysis API. Run
# `traceless-external-intelligence-worker --poll` as a separate process when any
# tenant connector has a non-null sync interval.
# Traceless never performs scraping. Tenant connector rows contain only endpoint,
# auth scheme and a reference into this operator-managed secret map. Configure the
# tenant endpoint/reference through PUT /api/v1/operational/intelligence/connectors/external.
# This is a nested JSON object: organization key -> credential reference -> binding.
# Both identifiers are exact and case-sensitive; case-variant duplicates are rejected.
# TRACELESS_EXTERNAL_INTELLIGENCE_CREDENTIALS={"tenant-id":{"tenant-feed-primary":{"secret":"replace-with-a-long-random-service-token","origin":"https://intel-pipeline.example.test"}}}
# TRACELESS_EXTERNAL_INTELLIGENCE_PAGE_SIZE=250
# TRACELESS_EXTERNAL_INTELLIGENCE_MAX_PAGES=20
# TRACELESS_EXTERNAL_INTELLIGENCE_MAX_RECORDS=5000
# TRACELESS_EXTERNAL_INTELLIGENCE_MAX_PAGE_BYTES=4194304
# TRACELESS_EXTERNAL_INTELLIGENCE_TIMEOUT_SECONDS=20
# TRACELESS_EXTERNAL_INTELLIGENCE_CLOCK_SKEW_SECONDS=300
# TRACELESS_EXTERNAL_INTELLIGENCE_STALE_RUN_SECONDS=3600
# TRACELESS_EXTERNAL_INTELLIGENCE_HEARTBEAT_SECONDS=15
# TRACELESS_EXTERNAL_INTELLIGENCE_WORKER_ID=external-intelligence-worker
# TRACELESS_EXTERNAL_INTELLIGENCE_SCHEDULER_BATCH_SIZE=50
# TRACELESS_EXTERNAL_INTELLIGENCE_SCHEDULE_CLAIM_SECONDS=300
# TRACELESS_EXTERNAL_INTELLIGENCE_SCHEDULE_RETRY_SECONDS=300

# Independent central intelligence publisher. It has its own ASGI app, database and
# Alembic history. Production requires PostgreSQL and explicit secrets.
# TRACELESS_PUBLISHER_ENVIRONMENT=production
# TRACELESS_PUBLISHER_DATABASE_URL=postgresql+psycopg://publisher_migrator@publisher-db/traceless_publisher
# TRACELESS_PUBLISHER_MIGRATION_ROLE=publisher_owner
# TRACELESS_PUBLISHER_SURFACE=feed
# TRACELESS_PUBLISHER_AUTO_CREATE_SCHEMA=false
# TRACELESS_PUBLISHER_ENABLE_DOCS=false
# TRACELESS_PUBLISHER_ADMIN_API_KEY=replace-with-at-least-32-random-characters
# TRACELESS_PUBLISHER_INGEST_API_KEY=replace-with-a-different-32-character-secret
# TRACELESS_PUBLISHER_REVIEWER_API_KEY=replace-with-a-different-32-character-secret
# TRACELESS_PUBLISHER_CURSOR_SECRET=replace-with-at-least-32-random-characters
# Base64-encoded raw 32-byte Ed25519 private seed. Store only in a secret manager.
# TRACELESS_PUBLISHER_SIGNING_PRIVATE_KEY=replace-with-standard-base64
# TRACELESS_PUBLISHER_SIGNING_KEY_ID=publisher-2026-01
# TRACELESS_PUBLISHER_FEED_ID=traceless-central-intelligence
# TRACELESS_PUBLISHER_FEED_EPOCH=1
# TRACELESS_PUBLISHER_ENABLE_LEGACY_V1_FEED=false
# TRACELESS_PUBLISHER_CREDENTIAL_OVERLAP_SECONDS=3600
# TRACELESS_PUBLISHER_CREDENTIAL_TTL_SECONDS=31536000
# TRACELESS_PUBLISHER_IMPORT_LEASE_SECONDS=900
# TRACELESS_PUBLISHER_ALLOW_AUTOMATIC_PUBLISH=false
# TRACELESS_PUBLISHER_ALLOWED_HOSTS=["publisher.example.com"]
# TRACELESS_PUBLISHER_MAX_REQUEST_BODY_BYTES=33554432
# TRACELESS_PUBLISHER_MAX_PAGE_SIZE=1000
# TRACELESS_PUBLISHER_MAX_IMPORT_ITEMS=1000
# TRACELESS_PUBLISHER_CURSOR_MAX_AGE_SECONDS=2592000
# TRACELESS_PUBLISHER_RATE_LIMIT_MAX_BUCKETS=50000
# TRACELESS_PUBLISHER_EXPECTED_DATABASE_ROLE=publisher_feed_api
# TRACELESS_PUBLISHER_REQUIRED_SCHEMA_REVISION=p4e1c6a2f540

# Optional read-only NetBox inventory source. Its process-global URL/token belong
# to exactly one organization UUID and the hostname allowlist is mandatory.
# Production requires the binding. In development/test only, omitting it limits
# NetBox to the built-in default organization UUID.
# TRACELESS_NETBOX_BASE_URL=https://netbox.example.test/
# TRACELESS_NETBOX_TOKEN=
# TRACELESS_NETBOX_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# TRACELESS_NETBOX_AUTH_SCHEME=Bearer
# TRACELESS_NETBOX_ALLOWED_HOSTS=["netbox.example.test"]
# TRACELESS_NETBOX_ALLOW_INSECURE_HTTP=false
# TRACELESS_NETBOX_PAGE_SIZE=100
# TRACELESS_NETBOX_MAX_PAGES=250
# TRACELESS_NETBOX_MAX_RECORDS=10000
# TRACELESS_NETBOX_MAX_PAGE_BYTES=4194304
# TRACELESS_NETBOX_TIMEOUT_SECONDS=20
